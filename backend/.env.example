# Copy to .env and fill in your own values. Never commit the real .env.
APP_NAME=Master GYM
BOT_NAME=FitBot
ENVIRONMENT=development
# Local development. For a hosted database paste the connection string as-is, e.g.
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./gym_coach.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The API model id, not the display name shown in AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Fallback used when Gemini's daily quota is gone. Free key, no card, from
# https://console.groq.com/keys â€” llama-3.1-8b-instant allows 14,400 requests a day.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Seconds to stop asking a provider that has said it is out of quota.
LLM_COOLDOWN_SECONDS=900
LLM_MAX_OUTPUT_TOKENS=500

# Timezone FitBot quotes class times in.
DISPLAY_TIMEZONE=Asia/Kolkata

MAX_UPLOAD_MB=15
# Comma-separated once deployed, e.g. https://your-site.pages.dev,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Per-caller limits on the endpoints anyone can reach. Chat costs LLM quota; login and signup
# invite guessing and spam. Set RATE_LIMIT_ENABLED=false only for load testing.
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600

# Logins whose passwords are printed on the sign-in page. The API lets them read anything and
# write nothing. Leave empty to turn the public tour off.
DEMO_ACCOUNT_EMAILS=admin-demo@example.com,trainer-demo@example.com,member-demo@example.com
