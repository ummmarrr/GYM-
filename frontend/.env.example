# Absolute URL of the deployed API, for example https://master-gym-api.onrender.com
# Set this in the Cloudflare Pages dashboard, not here.
#
# Leave it unset for local development: the Vite dev server proxies /api to 127.0.0.1:8000,
# so the browser sees one origin and no CORS is involved.
VITE_API_URL=
